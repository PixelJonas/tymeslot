# Build stage
#
# Pinned to the same Erlang the rest of the project builds on. The floating
# `elixir:1.20.3` tag tracks whichever OTP the image is rebuilt against, which
# silently moved this image a major release ahead of every other target. The
# Debian release is pinned to trixie to match the runtime stage below, so the
# bundled ERTS links against the same OpenSSL and ncurses it will find there.
FROM hexpm/elixir:1.20.3-erlang-28.5.0.5-debian-trixie-20260803-slim AS build

# Avoid prompts from apt and configure debconf
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NONINTERACTIVE_SEEN=true

# Set the locale to UTF-8
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Configure debconf and install build dependencies
#
# Debian sources default to plain http:// (see /etc/apt/sources.list.d/debian.sources
# in the base image), which some CI runner network policies block on egress while
# still allowing 443 - force https to the same mirror so apt-get update doesn't hang
# and time out.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections && \
    apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    autoconf \
    m4 \
    libncurses5-dev \
    libssl-dev \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Warm up egress to Hex's CDN before invoking mix.
#
# Diagnosed on this runner: the *first* outbound HTTPS connection from a fresh
# build container to any brand-new destination IP can take several seconds
# longer than normal (looks like reactive network-flow programming on the
# runner's SDN, not a domain/port block - every host tested, including ones
# that work fine on every later attempt, ate this same one-time delay). Mix's
# built-in Hex bootstrap installer has a hardcoded 60s httpc timeout and
# occasionally loses that race, failing with "Could not install Hex because
# Mix could not download metadata at https://builds.hex.pm/...". A throwaway
# curl (allowed to fail) pre-pays that one-time cost here, before anything
# depends on it succeeding quickly.
RUN curl -sS --max-time 45 -o /dev/null https://repo.hex.pm/ || true

# Install Hex/rebar explicitly and retry - belt-and-suspenders alongside the
# warm-up above, in case the delay is occasionally longer than the warm-up's
# own timeout allows for.
RUN for i in 1 2 3 4 5; do \
      mix local.hex --force --if-missing && mix local.rebar --force --if-missing && exit 0; \
      echo "hex/rebar install attempt $i failed, retrying..." >&2; \
      sleep 5; \
    done; \
    echo "hex/rebar install failed after 5 attempts" >&2; exit 1

# Set the working directory
WORKDIR /app

# Set build ENV early (before any mix commands)
ENV MIX_ENV=prod \
    NODE_ENV=production \
    DEPLOYMENT_TYPE=docker

# Copy mix files and config (build context is the repository root)
COPY mix.exs mix.lock ./
COPY config ./config

# Get dependencies using committed lock file
# Retry - see the warm-up comment above; deps.get's own hex.pm/repo.hex.pm
# requests aren't as exposed since the network path is already warm by now,
# but a retry here is cheap insurance against a genuinely transient blip.
RUN for i in 1 2 3; do \
      mix deps.get --only prod && exit 0; \
      echo "deps.get attempt $i failed, retrying..." >&2; \
      sleep 5; \
    done; \
    echo "deps.get failed after 3 attempts" >&2; exit 1

# Copy the rest of the application code. Wipe any locally-built assets first
# so the image build is hermetic — assets are always produced by mix assets.deploy
# below, never snuck in from the developer's local priv/static/assets/ directory.
COPY . .
RUN rm -rf priv/static/assets/

# Compile dependencies and application code
RUN mix do deps.compile + compile

# Install Tailwind and esbuild with retry mechanism
RUN for i in 1 2 3 4 5; do \
        echo "Attempt $i: Installing tailwind and esbuild" && \
        mix do tailwind.install + esbuild.install && break || sleep 5; \
    done  

# Install node_modules for the heroicons plugin — the standalone tailwind
# binary bundles @tailwindcss/forms but not the tailwindcss runtime that
# assets/heroicons.js needs via require("tailwindcss/plugin"), so it resolves
# them from the assets dir's node_modules.
RUN npm ci --prefix assets

# Compile assets
RUN mix assets.deploy

# Create the release. mix release embeds config/runtime.exs in the release
# itself, so no extra copy is needed.
RUN mix release tymeslot

# Slim production stage — debian only, no Elixir SDK, no PostgreSQL server.
# The release bundles its own ERTS. postgresql-client is kept for pg_isready,
# which the entrypoint uses to wait for the external database.
FROM debian:trixie-slim AS release-slim

# See the build stage's apt sources comment above - same http->https fix needed here.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libssl3 \
    libncurses6 \
    ca-certificates \
    locales \
    tzdata \
    ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Locale and timezone
RUN locale-gen C.UTF-8 && update-locale LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata

# App user and data directories
RUN useradd --create-home --shell /bin/bash app && \
    mkdir -p /app /app/data /app/data/uploads && \
    chown -R app:app /app

WORKDIR /app

# Copy the release from build stage
COPY --from=build --chown=app:app /app/_build/prod/rel/tymeslot ./

# Copy start script
COPY --chown=app:app start-docker.sh /app/start-docker.sh
RUN chmod +x /app/start-docker.sh

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MIX_ENV=prod \
    DEPLOYMENT_TYPE=docker \
    PHX_SERVER=true \
    PORT=4000 \
    TYMESLOT_EMBEDDED_DB=false

EXPOSE 4000

VOLUME ["/app/data"]

# The entrypoint runs as root to set up /app/data, then drops to the app user
# for the Elixir process.
USER root

CMD ["/app/start-docker.sh"]

# Default production stage — the slim image plus an embedded PostgreSQL server.
# This stage is last, so `docker build` without --target still produces the
# batteries-included image every existing self-hoster runs.
FROM release-slim AS release

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-contrib \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres:postgres /var/lib/postgresql && \
    chmod 700 /var/lib/postgresql/data

ENV TYMESLOT_EMBEDDED_DB=true

VOLUME ["/app/data", "/var/lib/postgresql/data"]
